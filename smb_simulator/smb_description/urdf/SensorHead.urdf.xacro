<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sensor_head">

	<xacro:macro name="sensor_head" params="*origin parent:=base_link name:=sensor_head RobotNs:=robot">
		<joint name="${name}_base_mount_joint" type="fixed">
			<xacro:insert_block name="origin" />
			<parent link="${parent}"/>
			<child link="${name}_base_link"/>
		</joint>

		<link name="${name}_base_link">
			<inertial>
				<mass value="0.001" />
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
			</inertial>
		</link>

		<xacro:arg name="gpu" default="true"/>
		
		<xacro:include filename="$(find lidar_description)/urdf/VLP-16-2.urdf.xacro"/>
		<xacro:VLP-16 parent="${name}_base_link" name="${name}_Top_Velodyne" topic="${name}_Top_Velodyne_Points" hz="10" lasers="32" samples="440" gpu="$(arg gpu)" collision_range="0.2" min_range="0.2" RobotNs="${RobotNs}">
			<origin xyz="0.03 0 0.08" rpy="0 0 0" />
		</xacro:VLP-16>

		<!-- <xacro:VLP-16 parent="${name}_base_link" name="${name}_Front_Velodyne" topic="${name}_Front_Velodyne_Points" hz="10" lasers="32" samples="440" gpu="false" collision_range="0.2" min_range="0.7" RobotNs="${RobotNs}">
			<origin xyz="0.1 -0.3 -0.1" rpy="0 0.5 0" />
		</xacro:VLP-16> -->

		<!-- <xacro:VLP-16 parent="${name}_base_link" name="${name}_Back_Velodyne" topic="${name}_Back_Velodyne_Points" hz="10" lasers="32" samples="440" gpu="false" collision_range="0.2" min_range="1.0" RobotNs="${RobotNs}">
			<origin xyz="-0.05 0.3 -0.1" rpy="0 -0.5 0" />
		</xacro:VLP-16> -->
	</xacro:macro>
</robot>