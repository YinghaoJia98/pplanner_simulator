<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="depthCamera" params="parent name *origin">
        <joint name="${name}_DepthCamera_joint" type="fixed">
            <xacro:insert_block name="origin"/>
            <parent link="${parent}"/>
            <child link="${name}_DepthCamera"/>
        </joint>

        <link name="${name}_DepthCamera">
            <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size=".001 .001 .001"/>
            </geometry>
            </collision>

            <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://go1_description/meshes/depthCamera.dae" scale="1 1 1"/>
            </geometry>
            </visual>

            <inertial>
            <mass value="1e-5" />
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
            </inertial>
        </link>

        <joint name="${name}_DepthCamera_optical_joint" type="fixed">
            <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
            <parent link="${name}_DepthCamera"/>
            <child link="${name}_DepthCamera_optical"/>
        </joint>

        <link name="${name}_DepthCamera_optical">
        </link>

        <gazebo reference="${name}_DepthCamera">
            <!-- <material>Gazebo/Black</material> -->
            <sensor name="${name}_DepthCamera_sensor" type="depth">
                <update_rate>16</update_rate>
                <camera>
                    <horizontal_fov>2.094</horizontal_fov>
                    <image>
                        <width>928</width>
                        <height>800</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>5</far>
                    </clip>
                </camera>
                <plugin name="camera_controller" filename="libgazebo_ros_openni_kinect.so">
                    <baseline>0.025</baseline>
                    <alwaysOn>true</alwaysOn>
                    <updateRate>1.0</updateRate>
                    <cameraName>${name}_DepthCamera</cameraName>
                    <imageTopicName>${name}_DepthCamera/color/image_raw</imageTopicName>
                    <cameraInfoTopicName>${name}_DepthCamera/color/camera_info</cameraInfoTopicName>
                    <depthImageTopicName>${name}_DepthCamera/depth/image_raw</depthImageTopicName>
                    <depthImageInfoTopicName>${name}_DepthCamera/depth/camera_info</depthImageInfoTopicName>
                    <!-- <pointCloudTopicName>/camera_${name}/depth/points</pointCloudTopicName> -->
                    <pointCloudTopicName>${name}_DepthCamera/depth/points</pointCloudTopicName>
                    <frameName>${name}_DepthCamera_optical</frameName>
                    <pointCloudCutoff>0.3</pointCloudCutoff>
                    <pointCloudCutoffMax>3.9</pointCloudCutoffMax>
                    <distortionK1>0.0</distortionK1>
                    <distortionK2>0.0</distortionK2>
                    <distortionK3>0.0</distortionK3>
                    <distortionT1>0.0</distortionT1>
                    <distortionT2>0.0</distortionT2>
                    <CxPrime>0</CxPrime>
                    <Cx>0.0045</Cx>
                    <Cy>0.0039</Cy>
                    <focalLength>0</focalLength>
                    <hackBaseline>0</hackBaseline>
                </plugin>
            </sensor>
        </gazebo>

    </xacro:macro>
</robot>